# NLeveL — правила для Apache (типовой российский хостинг)

# ---------- Кодировка ----------
AddDefaultCharset UTF-8

# ---------- Красивые адреса ----------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Существующие файлы и папки отдаём как есть (assets, app, картинки)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Админку не трогаем — у неё свои файлы
    RewriteRule ^admin(/|$) - [L]

    # Всё остальное — в роутер
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# ---------- Закрываем служебное ----------
<IfModule mod_rewrite.c>
    RewriteRule ^(data|inc|build|docs)/ - [F,L]
</IfModule>

<FilesMatch "\.(json|md|sh|log)$">
    Require all denied
</FilesMatch>

# content.json отдаётся только через PHP, напрямую — нет
<Files "content.json">
    Require all denied
</Files>

# ---------- Заголовки безопасности ----------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# ---------- Кэш статики ----------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/png  "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType text/css   "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/html  "access plus 0 seconds"
</IfModule>

# ---------- Сжатие ----------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/plain
</IfModule>

ErrorDocument 404 /index.php
