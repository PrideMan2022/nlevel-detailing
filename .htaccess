# NLeveL — правила для Apache (типовой российский хостинг)

# ---------- Кодировка ----------
AddDefaultCharset UTF-8

# ---------- Красивые адреса ----------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # HTTPS обязателен: без него Яндекс понижает, а браузер пишет «не защищено».
    # Строку можно убрать, если хостинг сам заворачивает на HTTPS.
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # Склейка www и без www — иначе у каждой страницы будет две версии
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

    # Существующие файлы и папки отдаём как есть (assets, app, картинки)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Админку не трогаем — у неё свои файлы
    RewriteRule ^admin(/|$) - [L]

    # Всё остальное — в роутер
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# ---------- Закрываем служебное ----------
<IfModule mod_rewrite.c>
    RewriteRule ^(data|inc|build|docs)/ - [F,L]
</IfModule>

<FilesMatch "\.(json|md|sh|log)$">
    Require all denied
</FilesMatch>

# content.json отдаётся только через PHP, напрямую — нет
<Files "content.json">
    Require all denied
</Files>

# ---------- Заголовки безопасности ----------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# ---------- Кэш статики ----------
<IfModule mod_expires.c>
    ExpiresActive On
    # Картинки не меняются — держим год
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/png  "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    # Стили и скрипты тоже: в ссылке стоит хеш, при правке адрес меняется
    ExpiresByType text/css   "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    # HTML всегда свежий — цены не должны залипать
    ExpiresByType text/html  "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
    # Ассеты с хешем в адресе можно кэшировать намертво
    <FilesMatch "\.(webp|png|jpe?g|svg|woff2?)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    # Сам обработчик кэша обновляться должен сразу
    <Files "sw.js">
        Header set Cache-Control "no-cache, max-age=0"
    </Files>
    <FilesMatch "\.(html|php)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

# ---------- Сжатие ----------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/plain
</IfModule>

ErrorDocument 404 /index.php
