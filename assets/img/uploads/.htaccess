# Здесь лежат только картинки. Выполнение любых скриптов запрещено.
php_flag engine off
<IfModule mod_rewrite.c>
    RewriteEngine Off
</IfModule>
<FilesMatch "\.(php|phtml|php[0-9]|phar|cgi|pl|py|sh|htaccess)$">
    Require all denied
</FilesMatch>
AddType text/plain .php .phtml .php5 .php7 .php8 .phar
